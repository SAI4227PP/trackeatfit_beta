{
  "expo": {
    "name": "TrackEatFit",
    "slug": "trackeatfit",
    "version": "1.0.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/premium_icon.png",
    "scheme": "com.inc.TrackEatFit",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inc.TrackEatFit",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to allow you to pick images.",
        "NSCameraUsageDescription": "We need access to your camera to allow you to take photos.",
        "NSBluetoothAlwaysUsageDescription": "We need access to Bluetooth to connect to health devices.",
        "NSLocationWhenInUseUsageDescription": "We need access to your location for activity tracking features like running, cycling, and walking.",
        "NSLocationAlwaysUsageDescription": "We need background location access to track your outdoor activities even when the app is not in use.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need location access to track your fitness activities and calculate distance."
      },
      "associatedDomains": ["applinks:trackeatfit.me"]
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.inc.TrackEatFit",
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK",
        "ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "trackeatfit.me",
              "pathPrefix": "/posts"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.inc.TrackEatFit",
              "host": "oauth2redirect",
              "pathPrefix": "/google"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyASyxX7Sik2F5xBYxqA5YZxLqYFwthlz-g"
        },
        "googleSignIn": {
          "apiKey": "AIzaSyASyxX7Sik2F5xBYxqA5YZxLqYFwthlz-g"
        }
      },
      "queries": {
        "packageVisibility": ["com.google.android.gms", "com.android.settings"]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/premium_icon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to bluetooth devices"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for activity tracking.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location in the background for activity tracking.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location while using the app for activity tracking.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "618c0a5c-d3c6-40b4-a27b-ccd0ec439381"
      },
      "router": {
        "origin": false
      },
      "EXPO_CLIENT_ID": "1074372441109-2umh9ce8gn855biuheju5r5fkdl85j2d.apps.googleusercontent.com",
      "IOS_CLIENT_ID": "1074372441109-vr6fdu3h8kp551lgq5gted80gb479n5c.apps.googleusercontent.com",
      "ANDROID_CLIENT_ID": "1074372441109-vr6fdu3h8kp551lgq5gted80gb479n5c.apps.googleusercontent.com",
      "WEB_CLIENT_ID": "1074372441109-hvl9jv3v4kggko3q54rirt8vviri12g1.apps.googleusercontent.com"
    },
    "owner": "hip6379",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    }
  }
}
